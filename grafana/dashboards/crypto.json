                        "query": "from(bucket: \"${SelectedBucket}\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => \r\n    r[\"_measurement\"] == \"crypto_prijzen_euro\" or \r\n    r[\"_measurement\"] == \"simulated_prices\"\r\n  )\r\n  |> filter(fn: (r) => r[\"_field\"] == \"bitcoin\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\r\n  |> yield(name: \"Bitcoin\")"
