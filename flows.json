    {
        "id": "c8bd356eba69d0e6",
        "type": "function",
        "z": "crypto-tab",
        "name": "function 2",
        "func": "// De data van Binance is nu een lijst (Array)\nvar prijzenlijst = msg.payload;\nvar nieuwePayload = {};\n\n// Loop door de lijst en koppel de juiste prijs aan de juiste naam\nprijzenlijst.forEach(function(item) {\n    if (item.symbol === \"BTCEUR\") {\n        nieuwePayload.bitcoin = parseFloat(item.price);\n    } else if (item.symbol === \"ETHEUR\") {\n        nieuwePayload.ethereum = parseFloat(item.price);\n    }\n});\n\n// Controleer of we data hebben om te voorkomen dat InfluxDB crasht\nif (Object.keys(nieuwePayload).length === 0) {\n    return null; \n}\n\nmsg.payload = nieuwePayload;\nmsg.measurement = \"crypto_prijzen_euro\"; \nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 400,
